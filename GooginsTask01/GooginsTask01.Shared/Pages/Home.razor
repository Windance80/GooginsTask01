@page "/"
@using GooginsTask01.Shared.Data.Models
@using GooginsTask01.Shared.Services
@using System.Diagnostics
@inject IFormFactor FormFactor
@inject IJSRuntime JSRuntime
@inject ITodoRepository TodoRepository

<PageTitle>Home</PageTitle>

@* CALENDAR *@
@* <div class="@headerHeightClass  w-1/2 sm:w-1/4"> *@
<div class="pt-5 ps-2 pe-2 w-1/2 sm:w-1/4">
    <!-- Keep original structure almost 100% the same -->
    <button popovertarget="cally-popover1" class="input input-border cursor-pointer" id="cally1"
        style="anchor-name:--cally1">

        <div class="flex justify-between w-full">
            <div id="cally1-date-text">
                @(SelectedDate.ToString("dd MMM yyyy") ?? "Pick a date")
            </div>

            <div class="p-1 bg-blue-600 flex items-center justify-center rounded-md">
                @* date icon *@
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"
                    class="size-4 text-white">
                    <path
                        d="M5.75 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM5 10.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM10.25 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM7.25 8.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM8 9.5A.75.75 0 1 0 8 11a.75.75 0 0 0 0-1.5Z" />
                    <path fill-rule="evenodd"
                        d="M4.75 1a.75.75 0 0 0-.75.75V3a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2V1.75a.75.75 0 0 0-1.5 0V3h-5V1.75A.75.75 0 0 0 4.75 1ZM3.5 7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1V7Z"
                        clip-rule="evenodd" />
                </svg>
            </div>
        </div>
    </button>

    <div popover id="cally-popover1" class="dropdown bg-base-100 rounded-box shadow-lg"
        style="position-anchor:--cally1">
        <calendar-date class="cally" @ref="@calendarRef">
            <svg aria-label="Previous" class="fill-current size-4" slot="previous" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24">
                <path d="M15.75 19.5 8.25 12l7.5-7.5"></path>
            </svg>
            <svg aria-label="Next" class="fill-current size-4" slot="next" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24">
                <path d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
            <calendar-month></calendar-month>
        </calendar-date>
    </div>
</div>

<div class="divider"></div>

@if (isCurrentTodoLoading)
{
    <div class="flex justify-center">
        <span class="loading loading-spinner loading-xl text-info"></span>
    </div>
}
else
{
    @if (CurrentTodo != null)
    {
        <ul class="list bg-base-100 rounded-box shadow-md">

            <li class="p-4 pb-2 text-xs opacity-60 tracking-wide">Tasks</li>

            @foreach (var todoItem in CurrentTodo.TodoItems)
            {
                <li class="text-2xl list-row">
                    @todoItem.Time.ToString("HH:mm")
                </li>

                var index = 1;
                @foreach (var item in todoItem.Items)
                {
                    <li class="list-row items-center">
                        <div class="text-xl font-thin opacity-30 tabular-nums">@($"0{index}")</div>
                        <div class="text-xl">
                            @item.Text
                        </div>

                        @* square icon *@
                        <button class="btn btn-square btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                <path
                                    d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Z" />
                            </svg>
                        </button>

                        @* checkbox icon *@
                        <button class="btn btn-square btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
                                <path
                                    d="m424-312 282-282-56-56-226 226-114-114-56 56 170 170ZM200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm0-560v560-560Z" />
                            </svg>
                        </button>

                        @* trash icon *@
                        <button class="btn btn-square btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path fill-rule="evenodd"
                                    d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z"
                                    clip-rule="evenodd" />
                            </svg>
                        </button>
                    </li>
                    index++;
                }

            }
        </ul>
    }
    else
    {
        <div class="flex justify-center text-info text-xl">
            Empty
        </div>
    }
}
@* <h1>Hello, world!</h1>

<div>
    Welcome to your new app running on <em>@factor</em> using <em>@platform</em>.
</div> *@

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();
    private ElementReference calendarRef;
    private DotNetObjectReference<Home>? dotNetHelper;
    private Todo? CurrentTodo { get; set; }
    private DateTime SelectedDate { get; set; } = DateTime.Today;
    bool isCurrentTodoLoading = true;    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isCurrentTodoLoading = true;

            dotNetHelper = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync("addCallyChangeListener", calendarRef, dotNetHelper);

            CurrentTodo = await TodoRepository.GetTodoByDateAsync(SelectedDate);
            isCurrentTodoLoading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleDateSelected(string isoDate)
    {
        isCurrentTodoLoading = true;
        StateHasChanged();
        await Task.Delay(500);

        if (DateTime.TryParse(isoDate, out var date))
        {
            SelectedDate = date.Date;
            CurrentTodo = await TodoRepository.GetTodoByDateAsync(SelectedDate);
        }

        isCurrentTodoLoading = false;
        StateHasChanged();
    }

}