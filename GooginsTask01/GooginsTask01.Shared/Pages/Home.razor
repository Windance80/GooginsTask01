@page "/"
@using GooginsTask01.Shared.Data.Models
@using GooginsTask01.Shared.Services
@using System.Diagnostics
@inject IFormFactor FormFactor
@inject IJSRuntime JSRuntime
@inject ITodoRepository TodoRepository
@implements IAsyncDisposable

<PageTitle>Home</PageTitle>

@* CALENDAR *@
@* <div class="@headerHeightClass  w-1/2 sm:w-1/4"> *@
<div class="pt-5 ps-2 pe-2 w-1/2 sm:w-1/4">
    <!-- Keep original structure almost 100% the same -->
    <button popovertarget="cally-popover1" class="input input-border cursor-pointer" id="cally1"
        style="anchor-name:--cally1">

        <div class="flex justify-between w-full">
            <div id="cally1-date-text">
                @(SelectedDate.ToString("dd MMM yyyy") ?? "Pick a date")
            </div>

            <div class="p-1 bg-info flex items-center justify-center rounded-md text-info-content">
                @* date icon *@
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4">
                    <path
                        d="M5.75 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM5 10.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM10.25 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM7.25 8.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM8 9.5A.75.75 0 1 0 8 11a.75.75 0 0 0 0-1.5Z" />
                    <path fill-rule="evenodd"
                        d="M4.75 1a.75.75 0 0 0-.75.75V3a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2V1.75a.75.75 0 0 0-1.5 0V3h-5V1.75A.75.75 0 0 0 4.75 1ZM3.5 7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1V7Z"
                        clip-rule="evenodd" />
                </svg>
            </div>
        </div>
    </button>

    <div popover id="cally-popover1" class="dropdown bg-base-100 rounded-box shadow-lg"
        style="position-anchor:--cally1">
        <calendar-date class="cally" @ref="@calendarRef">
            <svg aria-label="Previous" class="fill-current size-4" slot="previous" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24">
                <path d="M15.75 19.5 8.25 12l7.5-7.5"></path>
            </svg>
            <svg aria-label="Next" class="fill-current size-4" slot="next" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24">
                <path d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
            <calendar-month></calendar-month>
        </calendar-date>
    </div>
</div>

<div class="divider"></div>

@if (isCurrentTodoLoading)
{
    <div class="flex justify-center">
        <span class="loading loading-spinner loading-xl text-info"></span>
    </div>
}
else
{
    @if (CurrentTodo != null)
    {
        <ul class="list bg-base-100 rounded-box shadow-md">

            <li class="p-4 pb-2 text-xs opacity-60 tracking-wide sm:text-base">Tasks</li>

            @foreach (var todoItem in CurrentTodo.TodoItems)
            {
                @* time *@
                <li class="list-row items-center" >
                    <div class="text-xl sm:text-2xl text-info">
                        @todoItem.Time.ToString("HH:mm")
                    </div>

                    @* text for the list *@
                    <div>
                    </div>

                    @* add item button *@                    
                    <button class="btn btn-square btn-ghost btn-info"
                        onclick="document.getElementById('dialog-add-item-modal-@todoItem.Id').showModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 sm:size-10">
                            <path fill-rule="evenodd"
                                d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z"
                                clip-rule="evenodd" />
                        </svg>
                    </button>

                    @* dialog *@
                    <dialog id="dialog-add-item-modal-@todoItem.Id" class="modal modal-top">
                        <div class="modal-box">
                            <h3 class="text-lg font-bold">
                                @todoItem.Time.ToString("HH:mm")
                            </h3>
                            <div class="flex justify-center pt-4">
                                <textarea class="textarea grow" placeholder="Input text" @bind="newItemText" @bind:event="oninput">
                                            </textarea>
                            </div>
                            <div class="modal-action">
                                <form method="dialog">
                                    <!-- if there is a button in form, it will close the modal -->
                                    <button class="btn">Cancel</button>
                                    <button class="btn" @onclick="(_) => OnItemAdded(todoItem)">Ok</button>
                                </form>
                            </div>
                        </div>
                    </dialog>
                </li>

                @foreach (var item in todoItem.Items)
                {
                    @* item *@
                    <li class="list-row items-center">
                        <div class="sm:text-xl font-thin opacity-30 tabular-nums">@("-")</div>

                        <div class="sm:text-xl">
                            @item.Text
                            @* @item.TodoItemId *@
                            @* @item.Id *@
                        </div>

                        @* checkbox *@
                        <input type="checkbox" class="checkbox checkbox-info" @bind="@item.IsCompleted"
                            @bind:after="() => OnCheckboxChanged(item)" />

                        @* trash icon *@
                        @* @onclick="(_) => OnItemDeleted(item)" *@
                        <button class="btn btn-square btn-ghost btn-error"
                            onclick="document.getElementById('dialog-delete-item-modal-@todoItem.Id-@item.Id').showModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path fill-rule="evenodd"
                                    d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z"
                                    clip-rule="evenodd" />
                            </svg>
                        </button>
                        <dialog id="dialog-delete-item-modal-@todoItem.Id-@item.Id" class="modal modal-top">
                            <div class="modal-box">
                                <h3 class="text-lg font-bold">
                                    Delete
                                </h3>
                                <p class="py-4">
                                    @item.Text
                                </p>
                                <div class="modal-action">
                                    <form method="dialog">
                                        <!-- if there is a button in form, it will close the modal -->
                                        <button class="btn">Cancel</button>
                                        <button class="btn btn-error" @onclick="() => OnItemDeleted(item)">Ok</button>
                                    </form>
                                </div>
                            </div>
                        </dialog>
                    </li>
                }
            }
        </ul>
    }
    else
    {
        <div class="flex justify-center text-info text-xl">
            Empty
        </div>
    }
}

@* fab (floating action button) *@
<div id="my-fab" class="fab @footerHeightClass " style="inset-inline-end: @(fabRightEnd)px !important;">
    <div>
        <button class="btn btn-warning" @onclick="OnAddTime">
            <div class=" text-xs ">
                Add Time
            </div>

            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
        </button>
    </div>
</div>

<div id="my-fab" class="fab @footerHeightClass hidden" style="inset-inline-end: @(fabRightEnd)px !important;">
    <!-- a focusable div with tabindex is necessary to work on all browsers. role="button" is necessary for accessibility -->
    <div tabindex="0" role="button" class="btn btn-lg btn-circle btn-warning">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
            class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 18.75 7.5-7.5 7.5 7.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 7.5-7.5 7.5 7.5" />
        </svg>

    </div>

    <!-- close button should not be focusable so it can close the FAB when clicked. It's just a visual placeholder -->
    <div class="fab-close @footerHeightClass">
        Close <span class="btn btn-circle btn-lg btn-error">✕</span>
    </div>

    <!-- buttons that show up when FAB is open -->
    <div>
        <div class="text-warning text-xl font-bold bg-base-300 p-1">
            Add Time
        </div>
        <button class="btn btn-lg btn-circle btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>


        </button>
    </div>
    <div>
        <div class="text-warning text-xl font-bold bg-base-300 p-1">
            Previous Todo
        </div>
        <button class="btn btn-lg btn-circle btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>

        </button>
    </div>
    <div>
        <div class="text-warning text-xl font-bold bg-base-300 p-1">
            Favorites
        </div>
        <button class="btn btn-lg btn-circle btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
            </svg>

        </button>
    </div>
</div>

@* <h1>Hello, world!</h1>

<div>
    Welcome to your new app running on <em>@factor</em> using <em>@platform</em>.
</div> *@

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();

    @* theres one in MainLayout make sure adjust this *@
    string footerHeightClass = "pb-[60px]";
    
    @* calculate AfterFirstRender using Javascript interop *@
    string fabRightEnd = ""; 
    private ElementReference calendarRef;
    private DotNetObjectReference<Home>? dotNetHelper;
    private Todo? CurrentTodo { get; set; }
    private DateTime SelectedDate { get; set; } = DateTime.Today;
    bool isCurrentTodoLoading = true;
    private string newItemText { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isCurrentTodoLoading = true;

            dotNetHelper = DotNetObjectReference.Create(this);

             @* = await JSRuntime.InvokeAsync<string>("addFabListener", dotNetHelper); *@

            @* Console.WriteLine($"JSRuntime addFabeListener: widthEnd: {fabRightEnd}"); *@
            
            fabRightEnd = await JSRuntime.InvokeAsync<string>("addCallyChangeListener", calendarRef, dotNetHelper);

            CurrentTodo = await TodoRepository.GetTodoByDateAsync(SelectedDate);
            if (CurrentTodo != null)
                CurrentTodo.TodoItems = CurrentTodo.TodoItems.OrderBy(todoItem => todoItem.Time).ToList();

            isCurrentTodoLoading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleDateSelected(string isoDate)
    {
        isCurrentTodoLoading = true;
        StateHasChanged();
        await Task.Delay(500);

        if (DateTime.TryParse(isoDate, out var date))
        {
            SelectedDate = date.Date;
            CurrentTodo = await TodoRepository.GetTodoByDateAsync(SelectedDate);
        }

        if (CurrentTodo != null)
            CurrentTodo.TodoItems = CurrentTodo.TodoItems.OrderBy(todoItem => todoItem.Time).ToList();

        isCurrentTodoLoading = false;
        StateHasChanged();
    }

    public async Task OnItemAdded(TodoItem todoItem)
    {
        @* Console.WriteLine($"TodoItem time: {todoItem.Time} newItemText: {newItemText}"); *@
        if (CurrentTodo == null)
        {
            return;
        }

        for (int i = 0; i < CurrentTodo.TodoItems.Count; i++)
        {
            if (CurrentTodo.TodoItems[i].Id == todoItem.Id)
            {
                var itemId = CurrentTodo.TodoItems[i].Items.Count;
                CurrentTodo.TodoItems[i].Items.Add(
                new Item
                {
                    Id = itemId + 1,
                    IsCompleted = false,
                    Text = newItemText,
                    TodoItem = CurrentTodo.TodoItems[i],
                    TodoItemId = CurrentTodo.TodoItems[i].Id,
                }
                );
                i = CurrentTodo.TodoItems.Count;
            }
        }

        newItemText = "";
        await TodoRepository.UpdateTodoAsync(CurrentTodo);
        @* StateHasChanged(); *@
    }

    private async Task OnCheckboxChanged(Item item)
    {
        Console.WriteLine($"OnCheckboxChanged: {item.IsCompleted}");

        if (CurrentTodo == null)
            return;

        await TodoRepository.UpdateTodoAsync(CurrentTodo);
        @* StateHasChanged(); *@
    }

    private async Task OnItemDeleted(Item item)
    {
        Console.WriteLine($"OnCheckboxChanged: {item.IsCompleted}");

        if (CurrentTodo == null)
            return;

        await TodoRepository.DeleteItemAsync(item);

        CurrentTodo = await TodoRepository.GetTodoByDateAsync(SelectedDate);
        if (CurrentTodo != null)
            CurrentTodo.TodoItems = CurrentTodo.TodoItems.OrderBy(todoItem => todoItem.Time).ToList();
        @* StateHasChanged(); *@
    }

    ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            dotNetHelper?.Dispose();
            return ValueTask.CompletedTask;
        }
        catch (Exception exception)
        {
            Console.WriteLine($"DisposeAsync: {exception.Message}");
            return ValueTask.FromException(exception);
        }
    }

    private async Task OnAddTime(MouseEventArgs args)
    {
        if (CurrentTodo is null)
        {
            Console.WriteLine($"OnAddTime: CurrentTodo is null");
            return;
        }

        CurrentTodo.TodoItems.Add(
        new TodoItem
        {
            Id = CurrentTodo.TodoItems.Count + 1,
            Todo = CurrentTodo.TodoItems[0].Todo,
            TodoId = CurrentTodo.TodoItems[0].TodoId,
            @* Display modal to add time *@
        }
        );
    }
}